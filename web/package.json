{
  "name": "pumpflow-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "tokens": "node scripts/tokens.mjs",
    "predev": "node scripts/tokens.mjs",
