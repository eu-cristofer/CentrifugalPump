#!/bin/sh
# Leak guard: block a push whose new commits contain confidential words.
# Git calls this with: <remote-name> <remote-url>, and stdin lines
# "<local ref> <local sha> <remote ref> <remote sha>".
set -eu

remote_name="${1:-origin}"

if [ "${PUMP_LEAK_SKIP:-0}" = "1" ]; then
    echo "pre-push: WARNING: PUMP_LEAK_SKIP=1, leak scan skipped" >&2
    exit 0
fi

root=$(git rev-parse --show-toplevel)
list="${PUMP_WORDLIST:-$root/../CentrifugalPump-data/wordlist.txt}"

if [ ! -f "$list" ]; then
    echo "pre-push: word list not found: $list" >&2
    echo "pre-push: set PUMP_WORDLIST to the private word list file," >&2
    echo "pre-push: or set PUMP_LEAK_SKIP=1 to bypass the scan knowingly." >&2
    exit 1
fi

# True when the argument is made only of zeros (null object id).
is_zero() {
    case "$1" in
        *[!0]*) return 1 ;;
        *) return 0 ;;
    esac
}

py="${PYTHON:-python3}"

while read -r local_ref local_sha remote_ref remote_sha; do
    if is_zero "$local_sha"; then
        continue
    fi

    if is_zero "$remote_sha"; then
        base=""
        if git rev-parse --verify -q "refs/remotes/$remote_name/main" >/dev/null 2>&1; then
            base=$(git merge-base "$local_sha" "refs/remotes/$remote_name/main" 2>/dev/null) || base=""
        fi
        range="$base..$local_sha"
    else
        range="$remote_sha..$local_sha"
    fi

    if ! "$py" "$root/tools/leak_scan.py" --words "$list" --git-range "$range"; then
        echo "pre-push: confidential words found; push blocked" >&2
        exit 1
    fi
done

exit 0
